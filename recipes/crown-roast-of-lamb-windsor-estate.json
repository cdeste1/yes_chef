  "sub_recipes": [
    {
      "name": "Herb Crusted Crown Roast of Lamb",
      "yield": "Serves 4",
      "ingredients": [
        {
          "quantity": "2",
          "item": "Premium lamb racks",
          "note": ""
        },
        {
          "quantity": "2 tbsp",
          "item": "Dijon mustard",
          "note": ""
        },
        {
          "quantity": "2 tbsp",
          "item": "Lamb fat",
          "note": ""
        },
        {
          "quantity": "1 cup",
          "item": "Fresh parsley",
          "note": ""
        },
        {
          "quantity": "1/2 cup",
          "item": "Fresh mint",
          "note": ""
        },
        {
          "quantity": "1/2 cup",
          "item": "Fresh rosemary",
          "note": ""
        },
        {
          "quantity": "1 cup",
          "item": "Panko breadcrumbs",
          "note": ""
        },
        {
          "quantity": "1 tsp",
          "item": "Juniper berries",
          "note": ""
        },
        {
          "quantity": "2 tsp",
          "item": "Sea salt",
          "note": ""
        },
        {
          "quantity": "1 tsp",
          "item": "Black pepper",
          "note": ""
        }
      ],
      "steps": [
        {
          "instruction": "Season lamb with salt and pepper."
        },
        {
          "instruction": "Vacuum seal with lamb fat and cook sous vide at 131°F (55°C) for 90 minutes."
        },
        {
          "instruction": "Blend herbs, breadcrumbs, lamb fat, and ground juniper berries."
        },
        {
          "instruction": "Sear lamb and brush with Dijon mustard."
        },
        {
          "instruction": "Form into a crown roast and coat with herb crust."
        },
        {
          "instruction": "Roast at 425°F (220°C) for 8–10 minutes."
        },
        {
          "instruction": "Rest 10 minutes before carving."
        }
      ]
    },
    {
      "name": "Smoked Pea Purée",
      "yield": "4 servings",
      "ingredients": [
        {
          "quantity": "500g",
          "item": "English peas",
          "note": ""
        },
        {
          "quantity": "100ml",
          "item": "Heavy cream",
          "note": ""
        },
        {
          "quantity": "50g",
          "item": "Butter",
          "note": ""
        }
      ],
      "steps": [
        {
          "instruction": "Blanch peas and shock in ice water."
        },
        {
          "instruction": "Blend with cream and butter until smooth."
        },
        {
          "instruction": "Pass through a fine chinois."
        },
        {
          "instruction": "Cold smoke with applewood for 5 minutes."
        }
      ]
    },
    {
      "name": "Madeira Lamb Jus",
      "yield": "2 cups",
      "ingredients": [
        {
          "quantity": "2 lbs",
          "item": "Lamb bones",
          "note": ""
        },
        {
          "quantity": "2",
          "item": "Shallots",
          "note": ""
        },
        {
          "quantity": "2",
          "item": "Carrots",
          "note": ""
        },
        {
          "quantity": "1",
          "item": "Celery stalk",
          "note": ""
        },
        {
          "quantity": "2 tbsp",
          "item": "Tomato paste",
          "note": ""
        },
        {
          "quantity": "750ml",
          "item": "Lamb stock",
          "note": ""
        },
        {
          "quantity": "250ml",
          "item": "Madeira wine",
          "note": ""
        },
        {
          "quantity": "2 sprigs",
          "item": "Fresh thyme",
          "note": ""
        }
      ],
      "steps": [
        {
          "instruction": "Roast bones and vegetables until deeply caramelized."
        },
        {
          "instruction": "Add stock, Madeira, thyme, and tomato paste."
        },
        {
          "instruction": "Simmer 4–5 hours."
        },
        {
          "instruction": "Strain and reduce until glossy."
        },
        {
          "instruction": "Finish with cold butter."
        }
      ]
    },
    {
      "name": "Confit Shallots",
      "yield": "12 shallots",
      "ingredients": [
        {
          "quantity": "12",
          "item": "Banana shallots",
          "note": ""
        },
        {
          "quantity": "250ml",
          "item": "Duck fat",
          "note": ""
        }
      ],
      "steps": [
        {
          "instruction": "Cook shallots submerged in duck fat at 185°F (85°C) for 2 hours."
        }
      ]
    },
    {
      "name": "Glazed Heritage Carrots",
      "yield": "4 servings",
      "ingredients": [
        {
          "quantity": "12",
          "item": "Heritage baby carrots",
          "note": ""
        },
        {
          "quantity": "25g",
          "item": "Butter",
          "note": ""
        },
        {
          "quantity": "1 tbsp",
          "item": "Honey",
          "note": ""
        }
      ],
      "steps": [
        {
          "instruction": "Blanch carrots until tender."
        },
        {
          "instruction": "Glaze with butter and honey until shiny."
        }
      ]
    },
    {
      "name": "Mint Gel",
      "yield": "1 squeeze bottle",
      "ingredients": [
        {
          "quantity": "200ml",
          "item": "Mint juice",
          "note": ""
        },
        {
          "quantity": "2g",
          "item": "Agar agar",
          "note": ""
        }
      ],
      "steps": [
        {
          "instruction": "Simmer mint juice and agar."
        },
        {
          "instruction": "Chill until set."
        },
        {
          "instruction": "Blend smooth and transfer to squeeze bottle."
        }
      ]
    }
