  "sub_recipes": [
    {
      "name": "Fresh Agnolotti",
      "yield": "20-24 agnolotti",
      "ingredients": [
        {
          "item": "Italian 00 Flour",
          "quantity": "300 g"
        },
        {
          "item": "Whole Eggs",
          "quantity": "2"
        },
        {
          "item": "Egg Yolks",
          "quantity": "4"
        },
        {
          "item": "Olive Oil",
          "quantity": "10 ml"
        },
        {
          "item": "Sea Salt",
          "quantity": "8 g"
        },
        {
          "item": "Sheep’s Milk Ricotta",
          "quantity": "250 g"
        },
        {
          "item": "Parmigiano Reggiano",
          "quantity": "90 g"
        },
        {
          "item": "Lemon Zest",
          "quantity": "from 1 lemon"
        },
        {
          "item": "Nutmeg",
          "quantity": "small pinch"
        }
      ],
      "steps": [
        {
          "number": 1,
          "instruction": "Combine flour, eggs, yolks, olive oil, and salt into a smooth pasta dough."
        },
        {
          "number": 2,
          "instruction": "Vacuum seal and rest dough for 1 hour."
        },
        {
          "number": 3,
          "instruction": "Blend ricotta, Parmigiano, lemon zest, and nutmeg until silky smooth."
        },
        {
          "number": 4,
          "instruction": "Roll pasta sheets thin and pipe filling in small lines."
        },
        {
          "number": 5,
          "instruction": "Fold, seal, and cut agnolotti using a ripple pasta wheel."
        }
      ]
    },
    {
      "name": "Burnt Shallot Consommé",
      "yield": "1 liter",
      "ingredients": [
        {
          "item": "Shallots",
          "quantity": "8"
        },
        {
          "item": "Yellow Onions",
          "quantity": "2"
        },
        {
          "item": "Leek",
          "quantity": "1"
        },
        {
          "item": "Brown Chicken Stock",
          "quantity": "1 liter"
        },
        {
          "item": "Dry Sherry",
          "quantity": "150 ml"
        },
        {
          "item": "Kombu",
          "quantity": "1 sheet"
        },
        {
          "item": "Thyme Sprigs",
          "quantity": "3"
        },
        {
          "item": "Black Peppercorns",
          "quantity": "1 teaspoon"
        },
        {
          "item": "Egg Whites",
          "quantity": "2"
        }
      ],
      "steps": [
        {
          "number": 1,
          "instruction": "Deeply char shallots, onions, and leek in a dry copper pot."
        },
        {
          "number": 2,
          "instruction": "Deglaze with sherry and add stock, kombu, thyme, and peppercorns."
        },
        {
          "number": 3,
          "instruction": "Simmer gently for 45 minutes."
        },
        {
          "number": 4,
          "instruction": "Clarify using whisked egg whites and strain through a chinois étamine."
        },
        {
          "number": 5,
          "instruction": "Reduce slightly until intensely aromatic."
        }
      ]
    },
    {
      "name": "Brown Butter Pearls",
      "yield": "Small garnish batch",
      "ingredients": [
        {
          "item": "European Butter",
          "quantity": "150 g"
        },
        {
          "item": "Smoked Sea Salt",
          "quantity": "pinch"
        }
      ],
      "steps": [
        {
          "number": 1,
          "instruction": "Brown butter until nutty and aromatic."
        },
        {
          "number": 2,
          "instruction": "Pipe droplets onto an anti-griddle to create frozen pearls."
        },
        {
          "number": 3,
          "instruction": "Season lightly with smoked sea salt and freeze until service."
        }
      ]
    },
    {
      "name": "Parmigiano Foam",
      "yield": "500 ml",
      "ingredients": [
        {
          "item": "Heavy Cream",
          "quantity": "250 ml"
        },
        {
          "item": "Parmigiano Reggiano",
          "quantity": "120 g"
        },
        {
          "item": "Soy Lecithin",
          "quantity": "2 g"
        }
      ],
      "steps": [
        {
          "number": 1,
          "instruction": "Warm cream gently and infuse with Parmigiano for 20 minutes."
        },
        {
          "number": 2,
          "instruction": "Blend with soy lecithin until airy and smooth."
        },
        {
          "number": 3,
          "instruction": "Hold warm until plating."
        }
      ]
    }
  ]
}
